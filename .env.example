# ---------------------------------------------------------------------------
# BazyanHub — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings -> API). `.env.local` is gitignored.
#
# The app is designed to run WITHOUT these values: when they are missing,
# every Supabase query short-circuits and the local mock data in lib/data/
# is served instead. `next build` succeeds either way.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every table is
# protected by Row Level Security (see supabase-schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# The service role key bypasses Row Level Security entirely. It is not used
# by any code in this repo today; it is listed here only so that a future
# admin/moderation surface has a documented home for it.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# REQUIRED DASHBOARD SETTING — no env var, set it in Supabase itself:
#
#   Authentication -> Providers -> Email
#     * Email provider: ENABLED (it is on by default)
#     * "Confirm email": **OFF**  <-- this one is not optional
#
# The app signs users in with a username only. Supabase Auth requires an
# email, so lib/supabase/client.ts maps the username to a synthetic address
# (<username>@users.bazyanhub.app) that is never shown to the user. Those
# addresses cannot receive mail, so with "Confirm email" ON every signup
# returns a session-less user and NOBODY CAN EVER SIGN IN.
#
# Keeping it off is also what keeps signups clear of Supabase's email rate
# limits: no confirmation mail is ever sent.
#
# Consequence, accepted by design: there is no password reset, because there
# is no real address to send one to.
#
# Facebook and phone/SMS are NOT configured and NOT in the UI. Their helpers
# still exist in lib/supabase/client.ts if either is ever reinstated.
# ---------------------------------------------------------------------------
