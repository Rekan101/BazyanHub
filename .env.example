# ---------------------------------------------------------------------------
# BazyanHub — environment variables
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project dashboard (Project Settings -> API). `.env.local` is gitignored.
#
# The app is designed to run WITHOUT these values: when they are missing,
# every Supabase query short-circuits and the local mock data in lib/data/
# is served instead. `next build` succeeds either way.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: every table is
# protected by Row Level Security (see supabase-schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# The service role key bypasses Row Level Security entirely. It is not used
# by any code in this repo today; it is listed here only so that a future
# admin/moderation surface has a documented home for it.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Dashboard configuration required for the auth methods (no env vars needed,
# these are set in the Supabase dashboard itself):
#
#   1. Email + password
#      Authentication -> Providers -> Email. Enabled by default.
#
#   2. Username + password
#      No provider to enable. Usernames are mapped to a synthetic address
#      (<username>@users.bazyanhub.app) by lib/supabase/client.ts. Turn OFF
#      "Confirm email" for this to work, since these addresses cannot
#      receive mail: Authentication -> Providers -> Email -> Confirm email.
#
#   3. Facebook OAuth
#      Authentication -> Providers -> Facebook. Requires a Facebook App ID
#      and App Secret from developers.facebook.com. Add your redirect URL
#      (https://<project-ref>.supabase.co/auth/v1/callback) to the Facebook
#      app's "Valid OAuth Redirect URIs".
#
#   4. Phone + password
#      Authentication -> Providers -> Phone, plus SMS credentials from
#      Twilio / MessageBird / Vonage / Textlocal. This method stays inert
#      until those credentials are configured — the client code is ready.
# ---------------------------------------------------------------------------
